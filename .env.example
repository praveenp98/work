# Public site URL (used in sitemap, llms.txt, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rocco.works

# TrustMRR / hackathon traffic tracker. Paste the script src and site id from the TrustMRR dashboard.
NEXT_PUBLIC_TRACKER_SRC=
NEXT_PUBLIC_TRACKER_SITE_ID=

# Dodo Payments. Product IDs (pdt_...) for each plan, from the Dodo dashboard → Products. Not secret.
# Each product must have "License keys" enabled. DODO_MODE=test uses test.checkout / test API.
DODO_MODE=live
DODO_PRODUCT_HOLIDAY=
DODO_PRODUCT_SELLER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_AGENCY=

# Waitlist storage (Supabase). Table: waitlist(email text primary key, source text, created_at timestamptz default now())
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Text Rocco (LoopMessage). Without LOOPMESSAGE_API_KEY texting runs in dry-run (logged only).
LOOPMESSAGE_API_KEY=
# Optional: your sender name ID (dedicated sender). Leave empty for the default/shared sender.
LOOPMESSAGE_SENDER=
# "shared" when on a shared sender plan (needed for opt-in link generation)
LOOPMESSAGE_SENDER_TYPE=shared
# The opt-in link from LoopMessage dashboard (homepage "Text Rocco" button)
ROCCO_OPTIN_URL=
# Shared secret LoopMessage sends in the Authorization header of its webhook → /api/text/inbound
TEXT_WEBHOOK_SECRET=
# Vercel Cron secret for /api/cron/daily (morning numbers)
CRON_SECRET=
# Dodo API key (server) for the price ladder
DODO_API_KEY=

# Rocco's brain for texts (free-text replies, screenshot reading). Optional: rules-based replies without it.
ANTHROPIC_API_KEY=
