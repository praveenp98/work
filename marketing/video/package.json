{
  "name": "rocco-video",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion studio for Rocco marketing videos. Separate from the Next.js app on purpose.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare-site": "node scripts/prepare.mjs",
    "studio": "node scripts/prepare.mjs && remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit",
    "batch": "node scripts/batch.mjs",
    "profiles": "node scripts/profiles.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "opentype.js": "1.3.4",
    "postcss": "8.5.33",
    "postcss-prefix-selector": "2.2.1",
    "typescript": "5.9.2"
  }
}
